<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/orange_background"
    android:visibility="visible">



    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        tools:ignore="MissingConstraints">

        <Button
            android:id="@+id/carouselsButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Open Carousels" />

        <ImageView
            android:id="@+id/logo"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/logo"
            tools:ignore="ContentDescription,ImageContrastCheck,ImageContrastCheck" />



        <TextView
            android:id="@+id/textView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-black"
            android:gravity="center_horizontal"
            android:text="@string/the_most_adorable_places"
            android:textColor="@color/orange_light"
            android:textSize="30dp"
            tools:ignore="HardcodedText,SpUsage" />



        <Space
            android:layout_width="match_parent"
            android:layout_height="30dp">

        </Space>

        <TextView
            android:id="@+id/greece"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-black"
            android:gravity="center_horizontal"
            android:text="@string/greece"
            android:textColor="@color/orange"
            android:textSize="30dp"
            tools:ignore="HardcodedText,SpUsage" />
        <androidx.cardview.widget.CardView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="8dp"
            android:elevation="8dp"
            app:cardCornerRadius="40dp"
            app:cardBackgroundColor="#27FFFFFF">
        <ImageView
            android:id="@+id/ImageViewAthens"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent"
            android:adjustViewBounds="true"
            android:scaleType="centerCrop"
            android:src="@drawable/athenscover">
        </ImageView>
        </androidx.cardview.widget.CardView>


        <TextView
            android:id="@+id/italy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-black"
            android:gravity="center_horizontal"
            android:text="@string/italy"
            android:textColor="@color/orange"
            android:textSize="30dp"
            tools:ignore="HardcodedText,SpUsage" />
        <androidx.cardview.widget.CardView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="8dp"
            android:elevation="8dp"
            app:cardCornerRadius="40dp"
            app:cardBackgroundColor="#27FFFFFF">
        <ImageView
            android:id="@+id/ImageViewItaly"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent"
            android:adjustViewBounds="true"
            android:scaleType="centerCrop"
            android:src="@drawable/italy"/>
        </androidx.cardview.widget.CardView>


        <TextView
            android:id="@+id/spain"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-black"
            android:gravity="center_horizontal"
            android:text="@string/spain"
            android:textColor="@color/orange"
            android:textSize="30dp"
            tools:ignore="HardcodedText,SpUsage" />
           />
        <androidx.cardview.widget.CardView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="8dp"
            android:elevation="8dp"
            app:cardCornerRadius="40dp"
            app:cardBackgroundColor="#27FFFFFF">
        <ImageView
            android:id="@+id/ImageViewSpain"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent"
            android:adjustViewBounds="true"
            android:scaleType="centerCrop"
            android:src="@drawable/spain"
            />
        </androidx.cardview.widget.CardView>

        <TextView
            android:id="@+id/cyprus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-black"
            android:gravity="center_horizontal"
            android:text="@string/Cyprus"
            android:textColor="@color/orange"
            android:textSize="30dp"
            tools:ignore="HardcodedText,SpUsage" />
        />
        <androidx.cardview.widget.CardView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="8dp"
            android:elevation="8dp"
            app:cardCornerRadius="40dp"
            app:cardBackgroundColor="#27FFFFFF">
        <ImageView
            android:id="@+id/logoCyprus"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent"
            android:adjustViewBounds="true"
            android:scaleType="centerCrop"
            android:src="@drawable/cyprus"
            />
        </androidx.cardview.widget.CardView>


    </LinearLayout>
</ScrollView>