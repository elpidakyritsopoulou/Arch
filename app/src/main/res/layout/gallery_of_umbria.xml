<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/orange_background"
    android:hapticFeedbackEnabled="true"
    android:orientation="horizontal">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="16dp"
            tools:ignore="MissingConstraints">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top"
                android:orientation="horizontal"
                android:padding="8dp"
                tools:ignore="ExtraText">

                <Space
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1" />

                <ImageView
                    android:id="@+id/imageView2"
                    android:layout_width="76dp"
                    android:layout_height="71dp"
                    android:layout_gravity="end|top"
                    android:src="@drawable/logo"
                    android:contentDescription="@string/app_name" />
            </LinearLayout>

            <TextView
                android:id="@+id/Nicosia"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:text="@string/national_gallery_of_umbria"
                android:textColor="@color/orange"
                android:textSize="34sp"
                android:textStyle="bold"
                android:paddingTop="16dp"
                android:paddingBottom="16dp" />

            <HorizontalScrollView
                android:id="@+id/gallery"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="8dp"
                android:paddingBottom="8dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingHorizontal="8dp">

                    <ImageView
                        android:id="@+id/imageView9"
                        android:layout_width="300dp"
                        android:layout_height="190dp"
                        android:scaleType="centerCrop"
                        android:layout_marginEnd="8dp"
                        android:src="@drawable/umbria1"
                        android:contentDescription="@string/national_gallery_of_umbria" />

                    <ImageView
                        android:id="@+id/imageView7"
                        android:layout_width="300dp"
                        android:layout_height="190dp"
                        android:scaleType="centerCrop"
                        android:layout_marginEnd="8dp"
                        android:src="@drawable/umbria2"
                        android:contentDescription="@string/national_gallery_of_umbria" />

                    <ImageView
                        android:id="@+id/imageView8"
                        android:layout_width="300dp"
                        android:layout_height="190dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/umbria3"
                        android:contentDescription="@string/national_gallery_of_umbria" />
                </LinearLayout>
            </HorizontalScrollView>

            <TextView
                android:id="@+id/textView3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="casual"
                android:gravity="center"
                android:text="@string/national_gallery_of_umbria_text"
                android:textSize="14sp"
                android:textStyle="bold"
                android:paddingTop="16dp"
                android:paddingHorizontal="8dp" />
        </LinearLayout>
    </ScrollView>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/location"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_alignParentEnd="true"
        android:layout_margin="16dp"
        android:src="@drawable/location"
        android:contentDescription="@string/get_location"
        app:backgroundTint="@color/orange"
        app:fabSize="mini" />
</RelativeLayout>
